{
  "name": "@netlify/mcp",
  "version": "1.20.0",
  "description": "",
  "type": "module",
  "main": "./dist/netlify-mcp.js",
  "bin": {
    "netlify-mcp": "./dist/netlify-mcp.js"
  },
  "homepage": "https://docs.netlify.com/welcome/build-with-ai/netlify-mcp-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netlify/netlify-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/netlify/netlify-mcp/issues"
  },
  "scripts": {
    "build": "tsup ./netlify-mcp.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts-js-loader.mjs --test \"src/**/*.test.ts\" \"netlify/**/*.test.ts\"",
    "verify:coding-context": "node --import ./scripts/register-ts-js-loader.mjs scripts/verify-coding-context.mjs",
    "start": "node ./dist/netlify-mcp.js",
    "build:publish": "rm -rf ./dist && npm run build && npm publish"
  },
  "files": [
    "dist/*",
    "package.json"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.19.1",
    "@github/failbot": "0.8.3",
    "@github/hydro-analytics-client": "^2.3.3",
    "@gr2m/gray-matter": "4.0.3-with-pr-137",
    "@horizon-rs/language-guesser": "0.1.1",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@netlify/edge-functions": "^2.15.0",
    "@netlify/functions": "^4.1.4",
    "@octokit/graphql": "9.0.1",
    "@octokit/plugin-retry": "8.0.1",
    "@octokit/request-error": "7.0.0",
    "@primer/behaviors": "^1.7.2",
    "@primer/css": "21.3.1",
    "@primer/live-region-element": "^0.7.2",
    "@primer/octicons": "^19.19.0",
    "@primer/octicons-react": "^19.14.0",
    "@primer/primitives": "^11.3.1",
    "@primer/react": "^38.0.0",
    "accept-language-parser": "^1.5.0",
    "archiver": "^7.0.1",
    "env-paths": "^3.0.0",
    "fetch-to-node": "^2.1.0",
    "jose": "^6.0.11",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@netlify/open-api": "^2.57.1",
    "@types/node": "^22.15.32",
    "fflate": "0.8.2",
    "pkg-pr-new": "^0.0.88",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
